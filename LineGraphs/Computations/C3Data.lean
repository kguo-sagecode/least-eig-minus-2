/-- A block of twenty rows in the scaled Gram comparison. -/
def aGramChunk (k : ℕ) : Bool :=
  ((List.range 240).drop (20 * k) |>.take 20).all
    (checkScaledGramRow 9 4 e₈ARoots aImages)

