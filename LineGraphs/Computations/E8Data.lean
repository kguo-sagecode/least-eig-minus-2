/-- The five possible doubled inner products. -/
def e₈Allowed : List ℤ := [-8, -4, 0, 4, 8]

/-- Twenty roots per certificate, bounding peak kernel memory. -/
def e₈Chunk (k : ℕ) : List IntVector := (e₈Roots.drop (20 * k)).take 20

