  e₈AIndices10 ++
  e₈AIndices11

theorem e₈ARoots_eq_map : e₈ARoots =
    e₈AIndices.map (fun a ↦ List.ofFn (LineSystem.e₈ARoot a)) := by
  simp only [e₈AIndices, List.map_append,
    ← e₈A_table_chunk_0,
    ← e₈A_table_chunk_1,
    ← e₈A_table_chunk_2,
    ← e₈A_table_chunk_3,
    ← e₈A_table_chunk_4,
    ← e₈A_table_chunk_5,
    ← e₈A_table_chunk_6,
    ← e₈A_table_chunk_7,
    ← e₈A_table_chunk_8,
    ← e₈A_table_chunk_9,
    ← e₈A_table_chunk_10,
    ← e₈A_table_chunk_11]
  decide +kernel

theorem e₈ARoots_nodup : e₈ARoots.Nodup := by
  have h : (e₈ARoots.map modelVectorKey).IsChain (· < ·) := by decide +kernel
  exact List.Nodup.of_map modelVectorKey (List.isChain_iff_pairwise.mp h).nodup

theorem e₈ARoots_length : e₈ARoots.length = 240 := by decide +kernel

theorem mem_e₈AIndices (a : LineSystem.E₈AIndex) : a ∈ e₈AIndices :=
  mem_indices_of_image e₈ARoots_eq_map e₈ARoots_nodup
    (e₈ARoots_length.trans LineSystem.card_E₈AIndex.symm) a

theorem mem_e₈ARoots (w : IntVector) :
    w ∈ e₈ARoots ↔ ∃ a, List.ofFn (LineSystem.e₈ARoot a) = w := by
  rw [e₈ARoots_eq_map]
  exact mem_indexedRootTable e₈AIndices mem_e₈AIndices LineSystem.e₈ARoot w

theorem e₈A_decode_complete : e₈ARoots.all e₈ADecode = true := by decide +kernel

theorem e₈ADecode_iff (v : IntVector) : e₈ADecode v = true ↔ v ∈ e₈ARoots :=
  ⟨VectorTree.lookup_sound, fun h ↦ List.all_eq_true.mp e₈A_decode_complete v h⟩

end Computations
