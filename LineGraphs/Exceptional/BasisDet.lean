import LineGraphs.Exceptional.CertificateDefs
import LineGraphs.Exceptional.LatticeRank
import LineGraphs.Exceptional.LatticeCoordinates
import LineGraphs.Exceptional.BasisDetAlgebra

/-! # Computing the lattice determinant from a nonsingular principal submatrix

Lemma `lem:basisdet` (Lemma 2.4) of [Exc]. The subgroup is defined using the
integral adjugate coordinates, exactly as in the note.
-/

open Module Submodule Matrix

namespace SimpleGraph

variable {V : Type*} [Fintype V] [DecidableEq V]
  (X : SimpleGraph V) [DecidableRel X.Adj]

-- Lemma 2.4 [Exc]
/-- Lemma `lem:basisdet` (Lemma 2.4) of [Exc]: the subgroup generated by the
columns of `C` modulo `|det G|`. -/
noncomputable def basisDetGroup (B : Finset V) :
    AddSubgroup (B → ZMod (X.integralGramMatrix.certificateMatrix B).det.natAbs) :=
  AddSubgroup.closure (Set.range (fun u b ↦
    (X.integralGramMatrix.certificateCoordinates B b u :
      ZMod (X.integralGramMatrix.certificateMatrix B).det.natAbs)))

-- Lemma 2.4 [Exc]
/-- Lemma `lem:basisdet` (Lemma 2.4) of [Exc]: if a nonsingular principal
submatrix has size equal to the rank, then its determinant is positive and equals
the lattice determinant times the square of the order of the modular subgroup. -/
theorem certificateMatrix_det_eq_card_sq_mul_latticeDet (B : Finset V)
    (hp : ((2 : ℝ) • (1 : Matrix V V ℝ) + X.adjMatrix ℝ).PosSemidef)
    (hB : B.card = ((2 : ℝ) • (1 : Matrix V V ℝ) + X.adjMatrix ℝ).rank)
    (hG : (X.integralGramMatrix.certificateMatrix B).det ≠ 0) :
    0 < (X.integralGramMatrix.certificateMatrix B).det ∧
      (X.integralGramMatrix.certificateMatrix B).det.natAbs =
        (Nat.card (X.basisDetGroup B)) ^ 2 * X.latticeDet := by
  classical
  obtain ⟨x, hx⟩ := X.exists_representation_iff_posSemidef.mpr hp
  let b₀ := spanIntBasis x
  have hcard : Fintype.card (Fin (finrank ℤ (span ℤ (Set.range x)))) = Fintype.card B := by
    rw [hx.card_lattice_basis b₀, Fintype.card_coe, hB]
  let b := b₀.reindex (Fintype.equivOfCardEq hcard)
  let U := latticeCoordinates b
  let F := hx.latticeGramMatrix b
  let W : Matrix B B ℤ := U.submatrix id Subtype.val
  let G := X.integralGramMatrix.certificateMatrix B
  let D := G.det
  let K := G.adjugate * Wᵀ * F
  have hM : X.integralGramMatrix = Uᵀ * F * U :=
    hx.integralGramMatrix_eq_coordinates b
  have hGF : G = Wᵀ * F * W := by
    change X.integralGramMatrix.submatrix Subtype.val Subtype.val = _
    rw [hM]
    rfl
  have hW : W.det ≠ 0 := by
    intro hw
    have hh : G.det = 0 := by rw [hGF, Matrix.det_mul, hw, mul_zero]
    exact hG hh
  have hKW : K * W = D • 1 := by
    calc
      _ = G.adjugate * (Wᵀ * F * W) := by simp only [K, Matrix.mul_assoc]
      _ = D • 1 := by rw [← hGF, Matrix.adjugate_mul]
  have hWK : W * K = D • 1 := by
    apply (Matrix.isRegular_of_isLeftRegular_det (IsRegular.of_ne_zero hW).left).right
    change W * K * W = (D • 1) * W
    rw [Matrix.mul_assoc, hKW]
    simp only [Matrix.mul_smul, Matrix.smul_mul, Matrix.mul_one, Matrix.one_mul]
  have hC : X.integralGramMatrix.certificateCoordinates B = K * U := by
    change G.adjugate * X.integralGramMatrix.submatrix Subtype.val id = _
    rw [hM]
    change G.adjugate * (Wᵀ * F * U) = _
    simp only [K, Matrix.mul_assoc]
  have hH : X.basisDetGroup B = (K.modularHom D).range := by
    rw [Matrix.range_modularHom_eq_closure_columns K U D (latticeCoordinates_surjective b)]
    change AddSubgroup.closure _ = _
    rw [hC]
  have horder : Nat.card (X.basisDetGroup B) = W.det.natAbs := by
    rw [hH]
    exact Matrix.natCard_range_modularHom K W hG hW hKW hWK
  have hdet : D = W.det ^ 2 * (X.latticeDet : ℤ) := by
    change G.det = _
    rw [hGF, Matrix.det_mul, Matrix.det_mul, Matrix.det_transpose]
    change W.det * (hx.latticeGramMatrix b).det * W.det = _
    rw [hx.det_latticeGramMatrix b]
    ring
  have hpos : 0 < (X.latticeDet : ℤ) := by exact_mod_cast hx.latticeDet_pos
  refine ⟨?_, ?_⟩
  · change 0 < D
    rw [hdet]
    exact mul_pos (sq_pos_of_ne_zero hW) hpos
  · change D.natAbs = _
    rw [hdet, Int.natAbs_mul, Int.natAbs_pow, Int.natAbs_natCast, horder]

-- Lemma 2.4 [Exc]
/-- Lemma `lem:basisdet` (Lemma 2.4) of [Exc]: the square of the order of `H`
divides `D`, and the lattice determinant is `D / |H|²`. -/
theorem latticeDet_eq_div_card_basisDetGroup_sq (B : Finset V)
    (hp : ((2 : ℝ) • (1 : Matrix V V ℝ) + X.adjMatrix ℝ).PosSemidef)
    (hB : B.card = ((2 : ℝ) • (1 : Matrix V V ℝ) + X.adjMatrix ℝ).rank)
    (hG : (X.integralGramMatrix.certificateMatrix B).det ≠ 0) :
    0 < (X.integralGramMatrix.certificateMatrix B).det ∧
      (Nat.card (X.basisDetGroup B)) ^ 2 ∣ (X.integralGramMatrix.certificateMatrix B).det.natAbs ∧
      X.latticeDet = (X.integralGramMatrix.certificateMatrix B).det.natAbs /
        (Nat.card (X.basisDetGroup B)) ^ 2 := by
  obtain ⟨hpos, hmul⟩ := X.certificateMatrix_det_eq_card_sq_mul_latticeDet B hp hB hG
  have hn : 0 < (Nat.card (X.basisDetGroup B)) ^ 2 := by
    have hd : (X.integralGramMatrix.certificateMatrix B).det.natAbs ≠ 0 := Int.natAbs_ne_zero.mpr hG
    rw [hmul] at hd
    exact Nat.pos_of_ne_zero (mul_ne_zero_iff.mp hd).1
  refine ⟨hpos, ⟨X.latticeDet, hmul⟩, ?_⟩
  calc
    X.latticeDet = ((Nat.card (X.basisDetGroup B)) ^ 2 * X.latticeDet) /
        (Nat.card (X.basisDetGroup B)) ^ 2 := by
      rw [Nat.mul_comm, Nat.mul_div_cancel _ hn]
    _ = _ := congrArg (fun n ↦ n / (Nat.card (X.basisDetGroup B)) ^ 2) hmul.symm

end SimpleGraph
