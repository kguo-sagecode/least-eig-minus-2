import LineGraphs.LineSystem.SpanExtension

/-!
# Star closure (LN3)

The input `in6:LN3` of the Section 6 blueprint for [CGSS]. Starting with a line system, close
under the third root of a star. All generated inner products remain integral. The norm bound
then puts them in `{-2, -1, 0, 1, 2}`. Signatures against the original roots give finiteness.
This supplies the smallest star-closed extension in the same span, without classification.
-/

open scoped RealInnerProductSpace
open Submodule

namespace LineSystem

variable {V : Type*} [NormedAddCommGroup V] [InnerProductSpace ℝ V]

/-- Roots generated by adjoining the third vector of each star, for LN3 of [CGSS]. -/
inductive StarGenerated (S : LineSystem V) : V → Prop
  | root {r : V} : r ∈ S.Φ → StarGenerated S r
  | add {r s : V} : StarGenerated S r → StarGenerated S s → ⟪r, s⟫ = -1 →
      StarGenerated S (r + s)

/-- LN3: generated roots have squared norm two. -/
theorem StarGenerated.inner_self {S : LineSystem V} {r : V} (hr : S.StarGenerated r) :
    ⟪r, r⟫ = 2 := by
  induction hr with
  | root h => exact S.inner_self _ h
  | @add r s _ _ hrs ihr ihs =>
    rw [inner_add_left, inner_add_right, inner_add_right, ihr, ihs, hrs]
    rw [real_inner_comm, hrs]
    norm_num

/-- LN3: star generation does not enlarge the span. -/
theorem StarGenerated.mem_span {S : LineSystem V} {r : V} (hr : S.StarGenerated r) :
    r ∈ span ℝ S.Φ := by
  induction hr with
  | root h => exact subset_span h
  | add _ _ _ ihr ihs => exact add_mem ihr ihs

/-- LN3: the generated set contains both signs. -/
theorem StarGenerated.neg {S : LineSystem V} {r : V} (hr : S.StarGenerated r) :
    S.StarGenerated (-r) := by
  induction hr with
  | root h => exact .root (S.neg_mem _ h)
  | add _ _ hrs ihr ihs =>
    simpa only [neg_add] using StarGenerated.add ihr ihs (by rwa [inner_neg_neg])

/-- LN3: inner products between generated roots remain integers. -/
theorem StarGenerated.inner_integral {S : LineSystem V} {r s : V}
    (hr : S.StarGenerated r) (hs : S.StarGenerated s) :
    ∃ z : ℤ, ⟪r, s⟫ = z := by
  induction hr with
  | @root r hr =>
    induction hs with
    | root hs =>
      have h := S.inner_mem r hr _ hs
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at h
      rcases h with h | h | h | h | h
      · exact ⟨-2, by simpa using h⟩
      · exact ⟨-1, by simpa using h⟩
      · exact ⟨0, by simpa using h⟩
      · exact ⟨1, by simpa using h⟩
      · exact ⟨2, by simpa using h⟩
    | add _ _ _ ihr ihs =>
      obtain ⟨a, ha⟩ := ihr
      obtain ⟨b, hb⟩ := ihs
      exact ⟨a + b, by rw [inner_add_right, ha, hb, Int.cast_add]⟩
  | add _ _ _ ihr ihs =>
    obtain ⟨a, ha⟩ := ihr
    obtain ⟨b, hb⟩ := ihs
    exact ⟨a + b, by rw [inner_add_left, ha, hb, Int.cast_add]⟩

/-- LN3: integrality and the squared norm bound give the allowed inner products. -/
theorem StarGenerated.inner_mem {S : LineSystem V} {r s : V}
    (hr : S.StarGenerated r) (hs : S.StarGenerated s) :
    ⟪r, s⟫ ∈ ({-2, -1, 0, 1, 2} : Set ℝ) := by
  obtain ⟨z, hz⟩ := hr.inner_integral hs
  have hminus : 0 ≤ ⟪r - s, r - s⟫ := real_inner_self_nonneg
  have hplus : 0 ≤ ⟪r + s, r + s⟫ := real_inner_self_nonneg
  simp only [inner_sub_left, inner_sub_right, inner_add_left, inner_add_right,
    hr.inner_self, hs.inner_self, real_inner_comm r s, hz] at hminus hplus
  have hlo : (-2 : ℤ) ≤ z := by exact_mod_cast (show (-2 : ℝ) ≤ z by linarith)
  have hhi : z ≤ (2 : ℤ) := by exact_mod_cast (show (z : ℝ) ≤ 2 by linarith)
  rw [hz]
  interval_cases z <;> norm_num

/-- LN3: generated roots form a finite set, since their original-root signatures are finite. -/
theorem finite_starGenerated (S : LineSystem V) : {r | S.StarGenerated r}.Finite :=
  S.finite_spanCandidates.subset fun _ hr ↦
    ⟨hr.mem_span, hr.inner_self, fun _ hs ↦ hr.inner_mem (.root hs)⟩

-- Lemma LN3 (star closure)
/-- The smallest star-closed extension of a line system, LN3 (`in6:LN3`) used in
blueprint Lemma `lem:6-components`, Section 6 of [CGSS]. -/
def starClosure (S : LineSystem V) : LineSystem V where
  Φ := {r | S.StarGenerated r}
  finite := S.finite_starGenerated
  inner_self _ hr := hr.inner_self
  neg_mem _ hr := hr.neg
  inner_mem _ hr _ hs := hr.inner_mem hs

/-- LN3: star closure contains the original roots. -/
theorem subset_starClosure (S : LineSystem V) : S.Φ ⊆ S.starClosure.Φ :=
  fun _ hr ↦ .root hr

/-- LN3: star closure is star-closed in the sense of Definition 2.1 of [CGSS]. -/
theorem isStarClosed_starClosure (S : LineSystem V) : S.starClosure.IsStarClosed :=
  fun _ hr _ hs hrs ↦ .add hr hs hrs

/-- LN3: the star closure is contained in every star-closed extension. -/
theorem IsStarClosed.starClosure_subset {S T : LineSystem V} (hT : T.IsStarClosed)
    (hST : S.Φ ⊆ T.Φ) : S.starClosure.Φ ⊆ T.Φ := by
  intro r hr
  induction hr with
  | root h => exact hST h
  | add _ _ hrs ihr ihs => exact hT _ ihr _ ihs hrs

/-- LN3: the original and generated root sets have the same span. -/
theorem span_starClosure (S : LineSystem V) : span ℝ S.starClosure.Φ = span ℝ S.Φ :=
  le_antisymm (span_le.mpr fun _ hr ↦ hr.mem_span) (span_mono S.subset_starClosure)

/-- LN3: star closure preserves indecomposability, as used in `s6cfour`. -/
theorem IsIndecomposable.starClosure {S : LineSystem V} (hS : S.IsIndecomposable) :
    S.starClosure.IsIndecomposable := hS.of_span_eq S.subset_starClosure S.span_starClosure

end LineSystem
